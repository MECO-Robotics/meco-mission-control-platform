{
  "name": "meco-mission-control-platform",
  "version": "1.0.0",
  "description": "DigitalOcean-hosted API for MECO Mission Control.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "smtp:dev": "tsx watch scripts/dev-smtp.ts",
    "build": "tsc -p tsconfig.json",
    "contracts:generate": "node --import tsx scripts/contracts/generate-bootstrap-contract.ts",
    "contracts:verify": "node --import tsx scripts/contracts/verify-bootstrap-contract.ts",
    "test": "node scripts/test.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "npm run contracts:verify && npm run prisma:generate && npm run typecheck:test && npm test && npm run build",
    "smoke:test": "node scripts/smoke-test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma db push --skip-generate"
  },
  "keywords": [
    "meco",
    "fastify",
    "digitalocean",
    "prisma"
  ],
  "author": "Codex",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "9.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
