generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnshapeAuthMode {
  API_KEY
  OAUTH
}

enum CadSyncLevel {
  LINK_ONLY
  SHALLOW
  BOM
  DEEP_RELEASE
}

enum CadImportSource {
  STEP_UPLOAD
  ONSHAPE_API
  ONSHAPE_BOM_CSV
  MANUAL_BOM_CSV
}

enum CadImportStatus {
  PENDING
  PARSING
  PARSED
  MAPPING_REVIEW
  MAPPED
  FINALIZED
  FAILED
  CANCELED
}

enum CadSnapshotStatus {
  parsed
  mapping_review
  mapped
  finalized
  superseded
}

enum CadSnapshotSource {
  MANUAL_SNAPSHOT
  DESIGN_REVIEW
  MANUFACTURING_RELEASE
  AS_BUILT
  SCHEDULED_CANDIDATE
}

enum CadMappingSourceKind {
  ASSEMBLY_NODE
  PART_DEFINITION
  PART_INSTANCE
}

enum CadMappingTargetKind {
  SUBSYSTEM
  MECHANISM
  COMPONENT_ASSEMBLY
  PART_DEFINITION
  PART_INSTANCE
  IGNORE
  REFERENCE_GEOMETRY
  UNMAPPED
}

enum CadMappingConfidence {
  HIGH
  MEDIUM
  LOW
  MANUAL
}

enum CadSnapshotMappingStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  NEEDS_REVIEW
}

enum CadMappingMatchStrategy {
  STABLE_SIGNATURE
  INSTANCE_PATH
  NORMALIZED_NAME
  NORMALIZED_NAME_WITH_PARENT
  MANUAL_ONLY
}

enum CadAssemblyInferredType {
  ROOT
  SUBSYSTEM_CANDIDATE
  MECHANISM_CANDIDATE
  COMPONENT_ASSEMBLY_CANDIDATE
  SUBASSEMBLY
  UNKNOWN
}

enum CadWarningSeverity {
  INFO
  WARNING
  ERROR
}

enum OnshapePlanType {
  EDUCATION
  FREE
  STANDARD
  PROFESSIONAL
  ENTERPRISE
  UNKNOWN
}

model WebSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique @db.Char(64)
  csrfTokenHash  String   @db.Char(64)
  accountId      String
  authProvider   String
  email          String
  name           String
  picture        String?
  hostedDomain   String
  role           String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([email])
}

model MobileDeviceSession {
  id                String               @id @default(cuid())
  accountId         String
  authProvider      String
  email             String
  name              String
  picture           String?
  hostedDomain      String
  role              String
  deviceId          String
  deviceName        String?
  createdAt         DateTime             @default(now())
  lastUsedAt        DateTime
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  accessTokens      MobileAccessToken[]
  refreshTokens     MobileRefreshToken[]

  @@index([accountId, revokedAt])
  @@index([email, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model MobileAccessToken {
  id        String              @id @default(cuid())
  sessionId String
  tokenHash String              @unique
  createdAt DateTime            @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  session   MobileDeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
}

model MobileRefreshToken {
  id        String              @id @default(cuid())
  sessionId String
  tokenHash String              @unique
  createdAt DateTime            @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  session   MobileDeviceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
}

model OnshapeConnection {
  id                  String          @id @default(cuid())
  organizationId      String?
  authMode            OnshapeAuthMode @default(OAUTH)
  credentialReference String?
  baseUrl             String          @default("https://cad.onshape.com")
  disabledAt          DateTime?
  lastError           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model OnshapeDocumentRef {
  id             String         @id @default(cuid())
  projectId      String?
  seasonId       String?
  subsystemId    String?
  mechanismId    String?
  label          String
  documentId     String
  workspaceId    String?
  versionId      String?
  microversionId String?
  elementId      String?
  originalUrl    String
  parsedUrlJson  Json
  createdBy      String?
  importRuns     CadImportRun[]
  snapshots      CadSnapshot[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([documentId])
  @@index([workspaceId])
  @@index([versionId])
  @@index([microversionId])
  @@index([elementId])
  @@index([createdAt])
}

model CadImportRun {
  id                   String                 @id @default(cuid())
  projectId            String?
  seasonId             String?
  source               CadImportSource
  status               CadImportStatus        @default(PENDING)
  originalFilename     String
  uploadedFileId       String?
  uploadedFileHash     String?
  parserVersion        String?
  parseStartedAt       DateTime?
  parseCompletedAt     DateTime?
  requestedBy          String?
  errorMessage         String?
  rawSummaryJson       Json
  onshapeDocumentRefId String?
  syncLevel            CadSyncLevel?
  callsEstimated       Int?
  callsUsed            Int                    @default(0)
  stoppedReason        String?
  documentRef          OnshapeDocumentRef?    @relation(fields: [onshapeDocumentRefId], references: [id])
  requestLogs          OnshapeApiRequestLog[]
  snapshots            CadSnapshot[]
  warnings             CadImportWarning[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([projectId])
  @@index([seasonId])
  @@index([source])
  @@index([onshapeDocumentRefId])
  @@index([status])
  @@index([createdAt])
}

model OnshapeApiRequestLog {
  id                  String        @id @default(cuid())
  importRunId         String?
  endpoint            String
  method              String
  cacheKey            String
  usedCache           Boolean       @default(false)
  statusCode          Int?
  requestStartedAt    DateTime      @default(now())
  requestCompletedAt  DateTime?
  responseHeadersJson Json
  rateLimitRemaining  Int?
  errorMessage        String?
  importRun           CadImportRun? @relation(fields: [importRunId], references: [id])

  @@index([importRunId])
  @@index([cacheKey])
  @@index([requestStartedAt])
}

model OnshapeApiCacheEntry {
  id                  String    @id @default(cuid())
  cacheKey            String    @unique
  endpoint            String
  method              String
  requestHash         String
  responseJson        Json
  responseHeadersJson Json
  documentId          String?
  workspaceId         String?
  versionId           String?
  microversionId      String?
  elementId           String?
  immutable           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  expiresAt           DateTime?

  @@index([documentId])
  @@index([workspaceId])
  @@index([versionId])
  @@index([microversionId])
  @@index([elementId])
  @@index([createdAt])
}

model CadSnapshot {
  id                   String               @id @default(cuid())
  projectId            String?
  seasonId             String?
  importRunId          String
  source               CadImportSource
  label                String
  uploadedFileId       String?
  uploadedFileHash     String?
  previousSnapshotId   String?
  status               CadSnapshotStatus    @default(parsed)
  createdBy            String?
  finalizedBy          String?
  finalizedAt          DateTime?
  notes                String?
  subsystemId          String?
  mechanismId          String?
  onshapeDocumentRefId String?
  snapshotSource       CadSnapshotSource?
  documentId           String?
  workspaceId          String?
  versionId            String?
  microversionId       String?
  elementId            String?
  immutable            Boolean              @default(true)
  documentRef          OnshapeDocumentRef?  @relation(fields: [onshapeDocumentRefId], references: [id])
  importRun            CadImportRun         @relation(fields: [importRunId], references: [id])
  previousSnapshot     CadSnapshot?         @relation("CadSnapshotHistory", fields: [previousSnapshotId], references: [id])
  nextSnapshots        CadSnapshot[]        @relation("CadSnapshotHistory")
  assemblyNodes        CadAssemblyNode[]
  partDefinitions      CadPartDefinition[]
  partInstances        CadPartInstance[]
  mappings             CadSnapshotMapping[]
  mappingRules         CadMappingRule[]     @relation("CadRuleSourceSnapshot")
  warnings             CadImportWarning[]
  createdAt            DateTime             @default(now())

  @@index([projectId])
  @@index([seasonId])
  @@index([source])
  @@index([status])
  @@index([onshapeDocumentRefId])
  @@index([importRunId])
  @@index([documentId])
  @@index([elementId])
  @@index([createdAt])
}

model CadAssemblyNode {
  id                   String                  @id @default(cuid())
  snapshotId           String
  sourceId             String
  parentSourceId       String?
  parentAssemblyNodeId String?
  name                 String
  normalizedName       String
  instancePath         String
  depth                Int
  inferredType         CadAssemblyInferredType @default(UNKNOWN)
  stableSignature      String
  metadataJson         Json
  documentId           String?
  elementId            String?
  assemblyInstanceId   String?
  subsystemId          String?
  mechanismId          String?
  snapshot             CadSnapshot             @relation(fields: [snapshotId], references: [id])
  parentAssemblyNode   CadAssemblyNode?        @relation("CadAssemblyTree", fields: [parentAssemblyNodeId], references: [id])
  childAssemblyNodes   CadAssemblyNode[]       @relation("CadAssemblyTree")
  partInstances        CadPartInstance[]       @relation("CadAssemblyPartInstances")
  createdAt            DateTime                @default(now())

  @@unique([snapshotId, sourceId])
  @@index([snapshotId])
  @@index([stableSignature])
  @@index([normalizedName])
  @@index([documentId])
  @@index([elementId])
}

model CadPartDefinition {
  id                        String            @id @default(cuid())
  snapshotId                String
  sourceId                  String
  name                      String
  normalizedName            String
  partNumber                String?
  material                  String?
  stableSignature           String
  metadataJson              Json
  documentId                String?
  elementId                 String?
  partId                    String?
  versionId                 String?
  microversionId            String?
  mass                      Float?
  configuration             String?
  customPropertiesJson      Json?
  metadataHash              String?
  missionControlExternalKey String?
  snapshot                  CadSnapshot       @relation(fields: [snapshotId], references: [id])
  instances                 CadPartInstance[]
  createdAt                 DateTime          @default(now())

  @@unique([snapshotId, sourceId])
  @@index([snapshotId])
  @@index([stableSignature])
  @@index([partNumber])
  @@index([normalizedName])
  @@index([documentId])
  @@index([elementId])
  @@index([partId])
}

model CadPartInstance {
  id                   String             @id @default(cuid())
  snapshotId           String
  sourceId             String
  partDefinitionId     String?
  parentAssemblyNodeId String?
  instancePath         String
  quantity             Int                @default(1)
  stableSignature      String
  metadataJson         Json
  documentId           String?
  elementId            String?
  assemblyInstanceId   String?
  partId               String?
  suppressed           Boolean?
  configuration        String?
  transformJson        Json?
  snapshot             CadSnapshot        @relation(fields: [snapshotId], references: [id])
  cadPartDefinition    CadPartDefinition? @relation(fields: [partDefinitionId], references: [id])
  parentAssemblyNode   CadAssemblyNode?   @relation("CadAssemblyPartInstances", fields: [parentAssemblyNodeId], references: [id])
  createdAt            DateTime           @default(now())

  @@unique([snapshotId, sourceId])
  @@index([snapshotId])
  @@index([stableSignature])
  @@index([parentAssemblyNodeId])
  @@index([partDefinitionId])
  @@index([documentId])
  @@index([elementId])
  @@index([partId])
}

model CadMappingRule {
  id                    String                  @id @default(cuid())
  projectId             String
  seasonId              String?
  sourceKind            CadMappingSourceKind
  matchStrategy         CadMappingMatchStrategy
  matchValue            String
  targetKind            CadMappingTargetKind
  targetId              String?
  confidence            CadMappingConfidence
  createdFromSnapshotId String
  createdBy             String?
  createdAt             DateTime                @default(now())
  supersededByRuleId    String?
  active                Boolean                 @default(true)
  notes                 String?
  createdFromSnapshot   CadSnapshot             @relation("CadRuleSourceSnapshot", fields: [createdFromSnapshotId], references: [id])
  supersededByRule      CadMappingRule?         @relation("CadRuleSupersession", fields: [supersededByRuleId], references: [id])
  supersededRules       CadMappingRule[]        @relation("CadRuleSupersession")
  snapshotMappings      CadSnapshotMapping[]

  @@index([projectId])
  @@index([seasonId])
  @@index([sourceKind])
  @@index([matchStrategy, matchValue])
  @@index([targetKind, targetId])
  @@index([active])
}

model CadSnapshotMapping {
  id            String                   @id @default(cuid())
  snapshotId    String
  mappingRuleId String?
  sourceKind    CadMappingSourceKind
  sourceId      String
  targetKind    CadMappingTargetKind
  targetId      String?
  confidence    CadMappingConfidence
  status        CadSnapshotMappingStatus
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  snapshot      CadSnapshot              @relation(fields: [snapshotId], references: [id])
  mappingRule   CadMappingRule?          @relation(fields: [mappingRuleId], references: [id])

  @@unique([snapshotId, sourceKind, sourceId])
  @@index([snapshotId])
  @@index([mappingRuleId])
  @@index([targetKind, targetId])
  @@index([status])
}

model CadImportWarning {
  id           String                @id @default(cuid())
  importRunId  String
  snapshotId   String?
  severity     CadWarningSeverity
  code         String
  title        String
  message      String
  sourceKind   CadMappingSourceKind?
  sourceId     String?
  metadataJson Json
  importRun    CadImportRun          @relation(fields: [importRunId], references: [id])
  snapshot     CadSnapshot?          @relation(fields: [snapshotId], references: [id])
  createdAt    DateTime              @default(now())

  @@index([importRunId])
  @@index([snapshotId])
  @@index([sourceKind, sourceId])
  @@index([code])
  @@index([createdAt])
}

model OnshapeApiBudget {
  id                       String          @id @default(cuid())
  organizationId           String?
  planType                 OnshapePlanType @default(EDUCATION)
  annualCallBudget         Int?
  monthlyCallBudget        Int?
  dailySoftBudget          Int?
  perSyncSoftBudget        Int?
  callsUsedToday           Int             @default(0)
  callsUsedThisMonth       Int             @default(0)
  callsUsedThisYear        Int             @default(0)
  warningThresholdPercent  Int             @default(70)
  hardStopThresholdPercent Int             @default(90)
  lastResetAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([organizationId])
  @@index([createdAt])
}
